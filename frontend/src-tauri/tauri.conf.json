{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slave",
  "version": "0.1.0",
  "identifier": "dev.vey.slave",
  "build": {
    "devUrl": "http://localhost:4200",
    "frontendDist": "../dist/frontend/browser",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build:spa"
  },
  "app": {
    "windows": [
      {
        "title": "Slave",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
