
# DOCKER COMPOSE ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual API keys
# The backend services will automatically use these values

# LLM PROVIDER SELECTION
# ollama (default) | openai_compat (vLLM, llama.cpp server, LM Studio, OpenAI)
LLM_PROVIDER=ollama

# OPTIONAL: OLLAMA SERVICE SELECTION
# Leave empty for CPU, or set to http://ollama-gpu:11434
OLLAMA_URL=

# OPTIONAL: OpenAI-compatible server (used when LLM_PROVIDER=openai_compat)
# Base URL without /v1, e.g.:
# - vLLM:            http://host.docker.internal:8001
# - llama.cpp server: http://host.docker.internal:8081
# - OpenAI:          https://api.openai.com
OPENAI_COMPAT_BASE_URL=
# API key, sent as "Authorization: Bearer ..." only when non-empty
OPENAI_COMPAT_API_KEY=

# VECTOR STORE SELECTION
# mongo (default, embeddings in MongoDB, cosine in Python) | qdrant
VECTOR_STORE=mongo

# OPTIONAL: WEB SEARCH API KEYS
# Leave empty if you only want to use free providers (DuckDuckGo, SearXNG)
# Get your keys at:
# - Serper: https://serper.dev
# - Tavily: https://tavily.com

SERPER_API_KEY=
TAVILY_API_KEY=
# OPTIONAL: Backend API key (X-API-Key header). Leave empty to disable auth (local dev)
API_KEY=

# VOICE (local STT + TTS, all on-device)
# Enable/disable the /voice endpoints
VOICE_ENABLED=true
# faster-whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
# Piper TTS voice name ({locale}-{name}-{quality})
PIPER_VOICE=en_US-lessac-medium
