# Copy this file to .env and fill in your actual API keys

# DATABASE SETTINGS
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=slave

# SECURITY SETTINGS
# Optional API key. When set (non-empty), all API requests must include the
# X-API-Key header with this value. Leave empty to disable auth (local dev).
API_KEY=

# LLM SETTINGS
# Provider: ollama (default) | openai_compat (vLLM, llama.cpp server, LM Studio, OpenAI)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434

# OpenAI-compatible server (used when LLM_PROVIDER=openai_compat)
# Base URL without /v1, e.g.:
# - vLLM:            http://localhost:8001
# - llama.cpp server: http://localhost:8081
# - OpenAI:          https://api.openai.com
OPENAI_COMPAT_BASE_URL=
# API key, sent as "Authorization: Bearer ..." only when non-empty
OPENAI_COMPAT_API_KEY=

# CONTEXT PLANNER
# One small LLM call per message decides which web queries to run, which
# memories/history to retrieve and which uploaded files are relevant.
# false = skip the planner call and use the static fallback plan.
PLANNER_ENABLED=true

# VECTOR STORE SETTINGS
# Store: mongo (default, embeddings in MongoDB, cosine in Python) | qdrant
VECTOR_STORE=mongo
QDRANT_URL=http://localhost:6333

# SEMANTIC HISTORY
# Embed chat messages on save; retrieve relevant older messages beyond the
# recency window. false = recency window only.
HISTORY_VECTOR_ENABLED=true

# VISION
# Max image upload size in MB (pre-base64-encode)
VISION_IMAGE_MAX_MB=10

# JSON list of allowed origins (include the Tauri origins for the desktop app)
CORS_ORIGINS=["http://localhost:4200","http://localhost:4000","http://localhost:4173","tauri://localhost","http://tauri.localhost"]

# Logging verbosity: DEBUG | INFO | WARNING | ERROR (default: DEBUG)
LOG_LEVEL=INFO

# SearXNG - Self-hosted metasearch engine
SEARXNG_URL=http://localhost:8080

# Serper (Google Search API - PAID, requires API key)
# Get your key at: https://serper.dev
# Base URL only — the backend appends /search itself
SERPER_URL=https://google.serper.dev
SERPER_API_KEY=Set_your_key_here
SERPER_TOTAL_LIMIT=2500

# Tavily (Research API - PAID, requires API key)
# Get your key at: https://tavily.com
# Base URL only — the backend appends /search or /extract itself
TAVILY_URL=https://api.tavily.com
TAVILY_API_KEY=Set_your_key_here
TAVILY_MONTHLY_LIMIT=1000

# VOICE (local STT + TTS, all on-device)
# Enable/disable the /voice endpoints
VOICE_ENABLED=true
# faster-whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
# Piper TTS voice name ({locale}-{name}-{quality})
PIPER_VOICE=en_US-lessac-medium
# Where model files are downloaded/cached
VOICE_MODELS_DIR=/app/voice_models
